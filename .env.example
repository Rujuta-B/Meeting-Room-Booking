# .env.example (repo root)
#
# WHY a root .env is needed IN ADDITION TO api/.env: docker-compose.yml's
# own top-level `${POSTGRES_USER}` etc. substitutions (used to configure
# the `db` service) are resolved by Compose from a .env file sitting next
# to docker-compose.yml itself - a completely separate mechanism from
# `env_file: ./api/.env`, which only injects variables INTO the api
# container's process environment. These values should be IDENTICAL to the
# matching ones in api/.env.example, since both ultimately describe the
# same Postgres instance.
#
# Copy this file to .env (repo root) before running `docker compose up`.

POSTGRES_USER=booking_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=booking_dev
