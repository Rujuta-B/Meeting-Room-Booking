# api/.env.test.example
#
# WHY a SEPARATE test database, not the same one `docker compose up` uses
# for development: the test suite TRUNCATES tables between tests (see
# tests/helpers/factories.ts) - running tests against your dev database
# would wipe out any rooms/bookings you created manually while poking at
# the app. Point this at a different database NAME on the same Postgres
# instance (simplest for a POC - no second container needed).
#
# Copy this file to api/.env.test - vitest.config.ts explicitly loads it
# (via the `dotenv` package) before any test file runs, so DATABASE_URL
# and the JWT secrets below are what env.ts sees during the whole test
# run, keeping tests fully separate from your dev/.env database.

# With `docker compose up` running (so the `db` service/container is up),
# create the test database once:
#   docker compose exec db createdb -U booking_app booking_test
# Then this points at that same Postgres instance, different DB name.
DATABASE_URL=postgresql://booking_app:change_me_locally@localhost:5432/booking_test?schema=public

NODE_ENV=test
PORT=3001

JWT_ACCESS_SECRET=test_access_secret_at_least_16_chars
JWT_REFRESH_SECRET=test_refresh_secret_at_least_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=4

WEB_ORIGIN=http://localhost:5173

LOG_LEVEL=silent
