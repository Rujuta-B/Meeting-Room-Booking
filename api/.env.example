# api/.env.example
# Copy this file to api/.env (docker compose reads api/.env via env_file)
# and fill in real values before running `docker compose up`.

# --- Postgres ---
# These three values are used TWICE: once by the `db` service itself (to
# initialize the database), and once inside DATABASE_URL below (for the
# `api` service to connect to it). They must stay in sync - if you change
# one, change all three places.
POSTGRES_USER=booking_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=booking_dev

# --- App ---
NODE_ENV=development
PORT=3000

# The api and db containers' TZ/PGTZ are pinned to UTC directly in
# docker-compose.yml (not read from this file) - bookings.start_time/
# end_time are plain `timestamp` (no time zone) columns treated as UTC by
# convention everywhere in this app, and that only holds unconditionally if
# both containers' session timezone is explicitly UTC, not merely whatever
# the base images default to. No action needed here; this note exists so
# the assumption is visible from this file too.

# Prisma connects to the "db" service NAME, not localhost - the api
# container reaches Postgres over the Docker Compose network (an internal
# DNS Compose sets up between services), not the host machine's loopback
# interface. If you ever run the API outside Docker against a Postgres
# running on your own machine, change "db" to "localhost" here.
DATABASE_URL=postgresql://booking_app:change_me_locally@db:5432/booking_dev?schema=public

# --- JWT ---
# Two DIFFERENT long random strings - see src/lib/jwt.ts for why access
# and refresh tokens must never share a secret. Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Passwords ---
# bcrypt cost factor - higher is slower to compute but harder to brute
# force. 10 is a reasonable default for a POC.
BCRYPT_SALT_ROUNDS=10

# --- CORS ---
# The exact origin the frontend (web/) is served from - must match exactly
# (scheme + host + port), never a wildcard. See src/app.ts for why.
WEB_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# --- Azure (optional, unset for local dev) ---
# Leave both commented out for local Docker Compose dev - the app runs
# identically without them (see src/config/secrets.ts and
# src/lib/telemetry.ts, which are both complete no-ops when these are
# absent). Only set on an actual Azure Container Apps deployment - see
# azure/README.md.
# AZURE_KEY_VAULT_URL=https://<your-vault-name>.vault.azure.net/
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
